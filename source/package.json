{
  "name": "pocket-field-trip",
  "version": "0.3.0-android.4",
  "private": true,
  "type": "module",
  "description": "A small reason to step outside. Private Week 1 review build.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/runtime.mjs && tsc --noEmit && vite build && node scripts/release-notices.mjs && node scripts/service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/runtime.mjs",
    "format:check": "prettier --check src scripts tests promo playwright.config.ts tsconfig.json package.json index.html",
    "check:distribution": "node scripts/check-distribution.mjs",
    "test:data:e2e": "playwright test --config playwright.data.config.ts",
    "test:twenty:e2e": "playwright test --config playwright.twenty.config.ts",
    "test:flow:e2e": "playwright test --config playwright.flow-polish.config.ts",
    "test:maturity:e2e": "playwright test --config playwright.maturity.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.12"
  }
}
